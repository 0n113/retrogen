{
  "schemaVersion": 1,
  "id": "retrogen",
  "version": "${version}",
  "name": "Retrogen",
  "description": "Server-side Fabric mod for controlled, idempotent retroactive placed-feature generation in existing chunks.",
  "authors": [
    "Retrogen contributors"
  ],
  "license": "MIT",
  "contact": {
    "homepage": "https://github.com/0n113/retrogen",
    "sources": "https://github.com/0n113/retrogen",
    "issues": "https://github.com/0n113/retrogen/issues"
  },
  "environment": "server",
  "entrypoints": {
    "main": [
      "dev.retrogen.RetrogenMod"
    ]
  },
  "mixins": [
    "retrogen.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": ">=0.158.0"
  }
}
